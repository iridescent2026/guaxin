generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  nickname  String   @default("匿名旅人")
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")

  guaRecords    GuaRecord[]
  chatMessages  ChatMessage[]

  @@map("users")
}

model GuaRecord {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  question       String
  mood           String
  lines          String   // JSON string
  guaName        String   @map("gua_name")
  guaCode        String   @map("gua_code")
  interpretation String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("gua_records")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  roleId    String   @map("role_id")
  content   String
  sender    String
  isCrisis  Boolean  @default(false) @map("is_crisis")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("chat_messages")
}

model Character {
  id          String   @id @default(uuid())
  name        String
  title       String
  avatar      String?
  personality String
  promptKey   String   @unique @map("prompt_key")
  tags        String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("characters")
}

model Video {
  id        String   @id @default(uuid())
  title     String
  coverUrl  String   @map("cover_url")
  videoUrl  String   @map("video_url")
  platform  String
  category  String
  tags      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("videos")
}
