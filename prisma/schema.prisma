generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nickname  String   @default("匿名旅人")
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")

  guaRecords    GuaRecord[]
  chatMessages  ChatMessage[]

  @@map("users")
}

model GuaRecord {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  question       String   @db.VarChar(200)
  mood           String
  lines          String   @db.Text
  guaName        String   @map("gua_name")
  guaCode        String   @map("gua_code")
  interpretation String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("gua_records")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  roleId    String   @map("role_id")
  content   String   @db.Text
  sender    String
  isCrisis  Boolean  @default(false) @map("is_crisis")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, roleId])
  @@map("chat_messages")
}

model Character {
  id          String   @id @default(uuid())
  name        String
  title       String
  avatar      String?
  personality String   @db.Text
  promptKey   String   @unique @map("prompt_key")
  tags        String   @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("characters")
}

model Video {
  id        String   @id @default(uuid())
  title     String
  coverUrl  String   @map("cover_url")
  videoUrl  String   @map("video_url")
  platform  String
  category  String
  tags      String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("videos")
}
